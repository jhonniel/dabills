# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DaBills

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=DaBills <noreply@yourdomain.com>

# OCR (swap provider via OCR_PROVIDER: ocrspace | google-vision | mock)
OCR_PROVIDER=mock
OCR_SPACE_API_KEY=your-ocr-space-key
GOOGLE_VISION_API_KEY=your-google-vision-key

# Cron jobs (Vercel Cron)
# Protect endpoints with Authorization: Bearer $CRON_SECRET
CRON_SECRET=change-me-in-production

# Rate limiting is in-memory by default (see src/lib/security/rate-limit.ts).
# For multi-region production, swap for Redis / Upstash.
